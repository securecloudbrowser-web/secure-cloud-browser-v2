# Copy to .env and fill in locally. NEVER commit a real .env. No real secrets here.
#
# FREE STACK (primary deployment, see docs/FREE_STACK.md):
#   Code + CI   -> GitHub (free)
#   App hosting -> Vercel (free Hobby tier)
#   Database    -> Supabase Postgres (free tier) — set the values below in the
#                  Vercel project's Environment Variables, NOT in a committed file.

# --- Supabase (free tier) -----------------------------------------------------
# From your Supabase project: Settings -> API, and Settings -> Database.
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are the project's
# public API values (safe to expose to the browser; Row Level Security and the
# app's own backend authorization still protect the data).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# SERVICE ROLE KEY — SERVER ONLY. It bypasses Row Level Security.
# NEVER import it in browser/client code, never prefix it with NEXT_PUBLIC_,
# and never commit a real value. Only server-side code (API routes) may read it.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY"

# Prisma database URLs (Supabase Postgres — Supabase IS PostgreSQL).
# DATABASE_URL  = POOLED connection (PgBouncer, port 6543) — used by the app at
#                 runtime on Vercel (serverless-safe). Keep ?pgbouncer=true.
# DIRECT_URL    = DIRECT connection (port 5432) — used by Prisma for migrations
#                 only (prisma migrate). See prisma/schema.prisma datasource.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"
# Local development alternative (Docker Postgres from docker-compose.yml):
# DATABASE_URL="postgresql://appuser:CHANGE_ME@localhost:5432/cloudbrowser?schema=public"
# DIRECT_URL="postgresql://appuser:CHANGE_ME@localhost:5432/cloudbrowser?schema=public"

REDIS_URL="redis://localhost:6379"
SESSION_COOKIE_NAME="scb_session"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Email (REQUIRED in production for verification / password reset).
# The app must fail loudly in production if this is not configured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@example.com"

# Browser orchestration (separate host — see docs/FREE_STACK.md,
# "WHAT THIS STACK DOES NOT RUN"). The GitHub+Vercel+Supabase stack does NOT run
# the Chromium browser containers. ORCHESTRATOR_URL must point at the browser
# host you run yourself: the RDP server that hosts the
# browsers (v2: an RDP host, NOT the user's own PC and NOT a Codespace),
# running Docker + the orchestrator, exposed through a secure tunnel
# (Tailscale Funnel). On Vercel, set this to that host's
# public HTTPS URL — "localhost" there means Vercel itself, which has no Docker.
# Leave UNSET to use the honest local stub, which refuses to launch a browser.
ORCHESTRATOR_URL="http://localhost:4001"
ORCHESTRATOR_INTERNAL_TOKEN="CHANGE_ME"

# Browser limits (v2 Part A section 3 defaults)
BROWSER_CPU_LIMIT="2"
BROWSER_MEMORY_LIMIT_MB="2048"
BROWSER_PROFILE_DISK_LIMIT_MB="2048"
BROWSER_IDLE_TIMEOUT_MINUTES="30"
BROWSER_ABSOLUTE_SESSION_HOURS="12"
MAX_PROFILES_PER_USER="5"
MAX_SHARES_PER_PROFILE="5"
STREAM_TOKEN_TTL_SECONDS="300"

# --- Mailer (email verification via Gmail SMTP, free) ------------------------
# Emails are sent from your own Gmail. Create a Google App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords) and
# use it as SMTP_PASS. If these are unset/placeholders, sending is skipped
# and registration still succeeds (the verification token stays stored).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="YOUR_GMAIL_ADDRESS"
SMTP_PASS="YOUR_GOOGLE_APP_PASSWORD"
MAIL_FROM="YOUR_GMAIL_ADDRESS"
APP_URL="https://secure-cloud-browser.vercel.app"
